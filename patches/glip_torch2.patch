-                base_anchor_size = self.anchor_scale * stride * scale
-                anchor_size_x_2 = base_anchor_size * ratio[0] / 2.0
-                anchor_size_y_2 = base_anchor_size * ratio[1] / 2.0
-                # y1,x1,y2,x2
-                boxes = np.vstack((yv - anchor_size_y_2, xv - anchor_size_x_2,
