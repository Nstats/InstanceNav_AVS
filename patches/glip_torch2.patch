-                    'anchor': self.buffer[anchor_key].detach()}
-
-        if dtype == torch.float16:
-            dtype = np.float16
-        else:
-            dtype = np.float32
-
-        boxes_all = []
-        all_idx_strides = []
-        for idx_stride, stride in enumerate(self.strides):
