+                    self.by_cat[cat] = []
+
+                cur = sorted(cat_anns, key=lambda x: x["score"], reverse=True)[: self.topk]
+                self.by_cat[cat] = _merge_lists(self.by_cat[cat], cur, self.topk, key=lambda x: x["score"])
+        else:
+            by_id = defaultdict(list)
+            for ann in cur_results:
