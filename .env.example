DASHSCOPE_API_KEY=your-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENROUTER_API_KEY=your-openrouter-key
SILICONFLOW_API_KEY=your-siliconflow-key
QWEN_MODEL_NAME=qwen3-vl-flash
PSGNAV_MODEL_BACKEND=openai
PSGNAV_API_TIMEOUT=45
PSGNAV_API_RETRIES=2
PSGNAV_API_CONCURRENCY=4
PSGNAV_API_CACHE_SIZE=512
PSGNAV_API_MAX_TOKENS=1024

# Instance checks only; group/room LLM filters remain independent.
ENABLE_INSTANCE_CONFIRMATION=true
INSTANCE_CONFIRMATION_THRESHOLD=1
# Independent admission check; its result never adds confirmation votes.
VERIFY_BEFORE_CANDIDATE=true
